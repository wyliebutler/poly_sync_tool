{
  "name": "frontend",
  "private": true,
  "version": "2.0.4",
  "description": "Polyunity Sync App",
  "author": "Polyunity",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "vite": "vite",
    "dev": "concurrently \"npm run vite\" \"npm run electron\"",
    "electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "bump:version": "npm version patch --no-git-tag-version --force",
    "build:msi": "npm run bump:version && npm run build && electron-builder --win msi",
    "build:mac": "npm run bump:version && npm run build && electron-builder --mac dmg",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.polyunity.sync",
    "productName": "Polyunity Sync",
    "win": {
      "target": "msi",
      "icon": "public/icon.png"
    },
    "msi": {
      "oneClick": true,
      "perMachine": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "binaries": [
        "Contents/Resources/backend/polyunity_sync_daemon"
      ]
    },
    "dmg": {
      "sign": false
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "polyunity_sync_daemon.exe",
          "polyunity_sync_daemon"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "client_secrets.json"
        ]
      }
    ]
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  }
}
